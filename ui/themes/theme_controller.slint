import { Palette } from "std-widgets.slint";
import { MaterialPalette } from "@material";
import { R3xPalette, R3xThemeMode } from "../tokens/palette.slint";

export global R3xThemeController {
    callback theme_changed(mode: R3xThemeMode);

    public function apply_theme(mode: R3xThemeMode, system_dark: bool) {
        R3xPalette.theme_mode = mode;
        if mode == R3xThemeMode.light {
            R3xPalette.is_dark = false;
            R3xPalette.is_amoled = false;
            Palette.color-scheme = ColorScheme.light;
        } else if mode == R3xThemeMode.dark {
            R3xPalette.is_dark = true;
            R3xPalette.is_amoled = false;
            Palette.color-scheme = ColorScheme.dark;
        } else if mode == R3xThemeMode.amoled {
            R3xPalette.is_dark = true;
            R3xPalette.is_amoled = true;
            Palette.color-scheme = ColorScheme.dark;
        } else {
            R3xPalette.is_dark = system_dark;
            R3xPalette.is_amoled = false;
            Palette.color-scheme = system_dark ? ColorScheme.dark : ColorScheme.light;
        }

        MaterialPalette.schemes = R3xPalette.r3x_schemes(
            R3xPalette.custom_accent,
            R3xPalette.custom_accent_enabled,
            R3xPalette.is_amoled && R3xPalette.is_dark
        );
    }
}
