import { MaterialText, ScrollView, StateLayerArea } from "@material";
import { R3xPalette } from "../tokens/palette.slint";
import { R3xMetrics, R3xMotion } from "../tokens/metrics.slint";
import { R3xTypography } from "../tokens/typography.slint";
import { R3xIcons } from "../tokens/icons.slint";
import { R3xAppState } from "../state/app_state.slint";
import { CompactTag, StatusTone } from "../components/status_badge.slint";
import { HeroState } from "../components/connection_hero_button.slint";
import { EmptyStateView } from "../components/empty_error_state.slint";
import { HomeScreen } from "../screens/home_screen.slint";
import { SettingsFoundationScreen } from "../screens/settings_preview.slint";

component DrawerDestination {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> collapsed: false;

    callback clicked();

    min_height: 48px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;

    Rectangle {
        background: root.selected ? R3xPalette.secondary_container : transparent;
        border_radius: R3xMetrics.radius_full;
        clip: true;

        StateLayerArea {
            width: 100%;
            height: 100%;
            color: root.selected ? R3xPalette.on_secondary_container : R3xPalette.on_surface;
            tooltip: root.collapsed ? root.label : "";

            HorizontalLayout {
                padding_left: root.collapsed ? 0px : R3xMetrics.space_lg;
                padding_right: root.collapsed ? 0px : R3xMetrics.space_lg;
                spacing: R3xMetrics.space_md;
                alignment: root.collapsed ? center : start;

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 20px;
                        height: 20px;
                        source: root.icon;
                        colorize: root.selected ? R3xPalette.on_secondary_container : R3xPalette.on_surface_variant;
                    }
                }

                if !root.collapsed : MaterialText {
                    text: root.label;
                    style: R3xTypography.label_large;
                    color: root.selected ? R3xPalette.on_secondary_container : R3xPalette.on_surface_variant;
                    vertical_alignment: center;
                }
            }

            clicked => { root.clicked(); }
        }
    }
}

component MobileNavDestination {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;

    callback clicked();

    horizontal_stretch: 1;
    min_width: 64px;
    min_height: 48px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }

        VerticalLayout {
            alignment: center;
            spacing: R3xMetrics.space_xs;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 64px;
                    height: 32px;
                    border_radius: R3xMetrics.radius_full;
                    background: root.selected ? R3xPalette.secondary_container : transparent;

                    Image {
                        width: 22px;
                        height: 22px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.icon;
                        colorize: root.selected ? R3xPalette.on_secondary_container : R3xPalette.on_surface_variant;
                    }
                }
            }

            MaterialText {
                text: root.label;
                style: R3xTypography.label_medium;
                color: root.selected ? R3xPalette.on_surface : R3xPalette.on_surface_variant;
                horizontal_alignment: center;
            }
        }
    }
}

export component R3xAppShell {
    in property <bool> is_desktop: true;

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        // Desktop Left Navigation Drawer / Collapsible Rail
        if root.is_desktop : Rectangle {
            width: R3xAppState.drawer_collapsed ? R3xMetrics.rail_width : R3xMetrics.drawer_width;
            background: R3xPalette.surface_container_low;

            animate width {
                duration: R3xMetrics.dur_surface_enter;
                easing: R3xMotion.ease_standard;
            }

            // Right hairline divider
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: R3xPalette.outline_variant;
            }

            VerticalLayout {
                padding: R3xMetrics.space_lg;
                spacing: R3xMetrics.space_md;
                alignment: space_between;

                VerticalLayout {
                    spacing: R3xMetrics.space_lg;

                    // Brand header + collapse button
                    HorizontalLayout {
                        alignment: R3xAppState.drawer_collapsed ? center : space_between;
                        padding_left: R3xAppState.drawer_collapsed ? 0px : R3xMetrics.space_sm;

                        if !R3xAppState.drawer_collapsed : HorizontalLayout {
                            spacing: R3xMetrics.space_sm;
                            MaterialText {
                                text: "R3X";
                                style: R3xTypography.headline_md;
                                color: R3xPalette.on_surface;
                                vertical_alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                CompactTag { text: R3xAppState.app_version; }
                            }
                        }

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border_radius: 18px;
                            clip: true;

                            StateLayerArea {
                                width: 100%;
                                height: 100%;
                                color: R3xPalette.on_surface;
                                tooltip: R3xAppState.drawer_collapsed ? "Expand sidebar" : "Collapse sidebar";

                                Image {
                                    width: 20px;
                                    height: 20px;
                                    x: 8px;
                                    y: 8px;
                                    source: R3xAppState.drawer_collapsed ? R3xIcons.menu : R3xIcons.menu_open;
                                    colorize: R3xPalette.on_surface_variant;
                                }

                                clicked => {
                                    R3xAppState.drawer_collapsed = !R3xAppState.drawer_collapsed;
                                }
                            }
                        }
                    }

                    // 8 Navigation Destinations
                    VerticalLayout {
                        spacing: R3xMetrics.space_xs;

                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Главная" : "Home";
                            icon: R3xIcons.home;
                            selected: R3xAppState.current_nav == 0;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(0); }
                        }
                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Подписки" : "Subscriptions";
                            icon: R3xIcons.dns;
                            selected: R3xAppState.current_nav == 1;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(1); }
                        }
                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Серверы" : "Servers";
                            icon: R3xIcons.public;
                            selected: R3xAppState.current_nav == 2;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(2); }
                        }
                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Маршруты" : "Routing";
                            icon: R3xIcons.alt_route;
                            selected: R3xAppState.current_nav == 3;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(3); }
                        }
                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Соединения" : "Connections";
                            icon: R3xIcons.hub;
                            selected: R3xAppState.current_nav == 4;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(4); }
                        }
                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Диагностика" : "Diagnostics";
                            icon: R3xIcons.monitoring;
                            selected: R3xAppState.current_nav == 5;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(5); }
                        }
                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Ядра" : "Core Manager";
                            icon: R3xIcons.memory;
                            selected: R3xAppState.current_nav == 6;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(6); }
                        }
                        DrawerDestination {
                            label: R3xAppState.is_ru ? "Настройки" : "Settings";
                            icon: R3xIcons.settings;
                            selected: R3xAppState.current_nav == 7;
                            collapsed: R3xAppState.drawer_collapsed;
                            clicked => { R3xAppState.nav_selected(7); }
                        }
                    }
                }

                // Bottom Core Status Card
                if !R3xAppState.drawer_collapsed : Rectangle {
                    background: R3xPalette.surface_container;
                    border_radius: R3xMetrics.radius_xl;

                    HorizontalLayout {
                        padding: R3xMetrics.space_md;
                        spacing: R3xMetrics.space_sm;
                        alignment: space_between;

                        HorizontalLayout {
                            spacing: R3xMetrics.space_sm;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border_radius: 4px;
                                    background: R3xAppState.hero_state == HeroState.connected ? R3xPalette.success : R3xPalette.outline;
                                }
                            }
                            VerticalLayout {
                                MaterialText {
                                    text: R3xAppState.active_core_name;
                                    style: R3xTypography.label_medium;
                                    color: R3xPalette.on_surface;
                                }
                                MaterialText {
                                    text: R3xAppState.active_core_subtitle;
                                    style: R3xTypography.body_sm;
                                    color: R3xPalette.on_surface_variant;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 18px;
                                height: 18px;
                                source: R3xAppState.hero_state == HeroState.connected ? R3xIcons.verified_user : R3xIcons.shield;
                                colorize: R3xAppState.hero_state == HeroState.connected ? R3xPalette.success : R3xPalette.on_surface_variant;
                            }
                        }
                    }
                }
            }
        }

        // Main Workspace + Mobile Chrome
        VerticalLayout {
            horizontal_stretch: 1;

            // Mobile Top App Bar
            if !root.is_desktop : HorizontalLayout {
                padding_left: R3xMetrics.space_lg;
                padding_right: R3xMetrics.space_lg;
                padding_top: R3xMetrics.space_md;
                padding_bottom: R3xMetrics.space_sm;
                alignment: space_between;

                HorizontalLayout {
                    spacing: R3xMetrics.space_sm;
                    MaterialText {
                        text: "R3X";
                        style: R3xTypography.headline_md;
                        color: R3xPalette.on_surface;
                        vertical_alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        CompactTag {
                            text: R3xAppState.hero_state == HeroState.connected ? "TUN" : "Idle";
                            tone: R3xAppState.hero_state == HeroState.connected ? StatusTone.success : StatusTone.neutral;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: R3xMetrics.space_xs;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border_radius: 24px;
                        clip: true;
                        StateLayerArea {
                            width: 100%;
                            height: 100%;
                            color: R3xPalette.on_surface;
                            Image {
                                width: 22px;
                                height: 22px;
                                x: 13px;
                                y: 13px;
                                source: R3xAppState.hero_state == HeroState.connected ? R3xIcons.verified_user : R3xIcons.shield;
                                colorize: R3xAppState.hero_state == HeroState.connected ? R3xPalette.success : R3xPalette.on_surface_variant;
                            }
                            clicked => { R3xAppState.nav_selected(5); }
                        }
                    }
                }
            }

            // Scrollable Page Body
            ScrollView {
                vertical_stretch: 1;

                VerticalLayout {
                    padding: root.is_desktop ? R3xMetrics.page_desktop : R3xMetrics.page_mobile;
                    spacing: R3xMetrics.space_lg;

                    if R3xAppState.current_nav == 0 : HomeScreen {
                        is_desktop: root.is_desktop;
                    }

                    if R3xAppState.current_nav == 1 : EmptyStateView {
                        icon: R3xIcons.dns;
                        title: R3xAppState.is_ru ? "Подписки" : "Subscriptions";
                        description: R3xAppState.is_ru
                            ? "Локальное хранилище готово (" + R3xAppState.subscription_count + " подписок). Импорт URL/QR/YAML подключается на следующем этапе."
                            : "SQLite store initialized (" + R3xAppState.subscription_count + " feeds). Subscription parsers and HTTP refresh attach in Wave 2.";
                        action_label: R3xAppState.is_ru ? "На главную" : "Back to Home";
                        action_clicked => { R3xAppState.nav_selected(0); }
                    }

                    if R3xAppState.current_nav == 2 : EmptyStateView {
                        icon: R3xIcons.public;
                        title: R3xAppState.is_ru ? "Серверы и профили" : "Servers & Profiles";
                        description: R3xAppState.is_ru
                            ? "В базе данных: " + R3xAppState.profile_count + " профилей."
                            : "Stored profiles: " + R3xAppState.profile_count + ". Full server selector table and latency benchmark matrix arrive in Wave 3.";
                        action_label: R3xAppState.is_ru ? "На главную" : "Back to Home";
                        action_clicked => { R3xAppState.nav_selected(0); }
                    }

                    if R3xAppState.current_nav == 3 : EmptyStateView {
                        icon: R3xIcons.alt_route;
                        title: R3xAppState.is_ru ? "Маршрутизация и DNS" : "Routing & DNS";
                        description: R3xAppState.is_ru
                            ? "Активных правил маршрутизации: " + R3xAppState.routing_rule_count + "."
                            : "Configured routing rules: " + R3xAppState.routing_rule_count + ". Visual rule builder and DNS leak checks arrive in Wave 3.";
                        action_label: R3xAppState.is_ru ? "На главную" : "Back to Home";
                        action_clicked => { R3xAppState.nav_selected(0); }
                    }

                    if R3xAppState.current_nav == 4 : EmptyStateView {
                        icon: R3xIcons.hub;
                        title: R3xAppState.is_ru ? "Активные соединения" : "Active Connections";
                        description: R3xAppState.is_ru
                            ? "Инспектор соединений подключается вместе с сетевыми ядрами."
                            : "Live connection inspector attaches to running core APIs in Wave 2/3.";
                        action_label: R3xAppState.is_ru ? "На главную" : "Back to Home";
                        action_clicked => { R3xAppState.nav_selected(0); }
                    }

                    if R3xAppState.current_nav == 5 : EmptyStateView {
                        icon: R3xIcons.monitoring;
                        title: R3xAppState.is_ru ? "Диагностика и журналы" : "Diagnostics & Logs";
                        description: R3xAppState.is_ru
                            ? "Центр журналирования активен (" + R3xAppState.log_entry_count + " записей, с автоматическим скрытием секретов)."
                            : "Redacted LogHub active (" + R3xAppState.log_entry_count + " entries recorded). Network Doctor checks arrive in Wave 3.";
                        action_label: R3xAppState.is_ru ? "На главную" : "Back to Home";
                        action_clicked => { R3xAppState.nav_selected(0); }
                    }

                    if R3xAppState.current_nav == 6 : EmptyStateView {
                        icon: R3xIcons.memory;
                        title: R3xAppState.is_ru ? "Менеджер ядер" : "Core Manager";
                        description: R3xAppState.is_ru
                            ? "Контракт адаптеров и Smart Core Selector готовы. Манифесты Xray, sing-box, Mihomo и расширенных ядер подключаются в Wave 2."
                            : "CoreAdapter contract and Smart Core Selector ready. Xray-core, sing-box, Mihomo, and extended core adapters arrive in Wave 2/3.";
                        action_label: R3xAppState.is_ru ? "На главную" : "Back to Home";
                        action_clicked => { R3xAppState.nav_selected(0); }
                    }

                    if R3xAppState.current_nav == 7 : SettingsFoundationScreen {
                        is_desktop: root.is_desktop;
                    }
                }
            }

            // Mobile 80px Bottom Navigation Bar (4 destinations)
            if !root.is_desktop : Rectangle {
                height: R3xMetrics.bottom_bar_height;
                background: R3xPalette.surface_container;

                HorizontalLayout {
                    padding_left: R3xMetrics.space_sm;
                    padding_right: R3xMetrics.space_sm;
                    spacing: R3xMetrics.space_sm;

                    MobileNavDestination {
                        label: R3xAppState.is_ru ? "Главная" : "Home";
                        icon: R3xIcons.home;
                        selected: R3xAppState.current_nav == 0;
                        clicked => { R3xAppState.nav_selected(0); }
                    }
                    MobileNavDestination {
                        label: R3xAppState.is_ru ? "Подписки" : "Subscriptions";
                        icon: R3xIcons.dns;
                        selected: R3xAppState.current_nav == 1;
                        clicked => { R3xAppState.nav_selected(1); }
                    }
                    MobileNavDestination {
                        label: R3xAppState.is_ru ? "Диагностика" : "Diagnostics";
                        icon: R3xIcons.monitoring;
                        selected: R3xAppState.current_nav == 5;
                        clicked => { R3xAppState.nav_selected(5); }
                    }
                    MobileNavDestination {
                        label: R3xAppState.is_ru ? "Настройки" : "Settings";
                        icon: R3xIcons.settings;
                        selected: R3xAppState.current_nav == 7;
                        clicked => { R3xAppState.nav_selected(7); }
                    }
                }
            }
        }
    }
}
