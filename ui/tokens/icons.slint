export global R3xFlags {
    out property <image> de: @image-url("../assets/flags/de.svg");
    out property <image> pl: @image-url("../assets/flags/pl.svg");
    out property <image> nl: @image-url("../assets/flags/nl.svg");
    out property <image> ru: @image-url("../assets/flags/ru.svg");
    out property <image> ua: @image-url("../assets/flags/ua.svg");
    out property <image> gb: @image-url("../assets/flags/gb.svg");
    out property <image> us: @image-url("../assets/flags/us.svg");
    out property <image> jp: @image-url("../assets/flags/jp.svg");
    out property <image> sg: @image-url("../assets/flags/sg.svg");
    out property <image> ch: @image-url("../assets/flags/ch.svg");
    out property <image> fi: @image-url("../assets/flags/fi.svg");
    out property <image> se: @image-url("../assets/flags/se.svg");
    out property <image> fr: @image-url("../assets/flags/fr.svg");
    out property <image> ca: @image-url("../assets/flags/ca.svg");
    out property <image> tr: @image-url("../assets/flags/tr.svg");
    out property <image> hk: @image-url("../assets/flags/hk.svg");
    out property <image> xx: @image-url("../assets/flags/xx.svg");

    pure public function by_code(code: string) -> image {
        if code == "DE" || code == "de" { return root.de; }
        if code == "PL" || code == "pl" { return root.pl; }
        if code == "NL" || code == "nl" { return root.nl; }
        if code == "RU" || code == "ru" { return root.ru; }
        if code == "UA" || code == "ua" { return root.ua; }
        if code == "GB" || code == "gb" { return root.gb; }
        if code == "US" || code == "us" { return root.us; }
        if code == "JP" || code == "jp" { return root.jp; }
        if code == "SG" || code == "sg" { return root.sg; }
        if code == "CH" || code == "ch" { return root.ch; }
        if code == "FI" || code == "fi" { return root.fi; }
        if code == "SE" || code == "se" { return root.se; }
        if code == "FR" || code == "fr" { return root.fr; }
        if code == "CA" || code == "ca" { return root.ca; }
        if code == "TR" || code == "tr" { return root.tr; }
        if code == "HK" || code == "hk" { return root.hk; }
        return root.xx;
    }
}
