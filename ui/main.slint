import { MaterialWindowAdapter } from "@material";
import { R3xPalette, R3xThemeMode } from "tokens/palette.slint";
import { R3xMetrics } from "tokens/metrics.slint";
import { R3xAppState } from "state/app_state.slint";
import { R3xThemeController } from "themes/theme_controller.slint";
import { R3xAppShell } from "layouts/app_shell.slint";

export { MaterialWindowAdapter, R3xPalette, R3xMetrics, R3xAppState, R3xThemeController }

export component MainWindow inherits Window {
    in property <bool> disable_hover;

    title: "R3X — Many cores. One experience.";
    background: R3xPalette.surface;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 360px;
    min-height: 600px;

    changed disable_hover => {
        MaterialWindowAdapter.disable_hover = root.disable_hover;
    }

    init => {
        R3xThemeController.apply_theme(R3xThemeMode.dark, true);
    }

    R3xAppShell {
        width: 100%;
        height: 100%;
        is_desktop: root.width >= R3xMetrics.expanded_min;
    }
}
